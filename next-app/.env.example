# Safe-to-expose values used by the browser client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_APP_URL=https://equipment.example.com
NEXT_TELEMETRY_DISABLED=1

# Server-only integration values. Never commit real values.
SUPABASE_SERVICE_ROLE_KEY=replace_with_a_server_secret_manager_value
APPS_SCRIPT_EXPORT_URL=https://script.google.com/macros/s/replace_me/exec
APPS_SCRIPT_INTEGRATION_SECRET=replace_with_a_secret_manager_value
SOFTWARE_LICENSE_ENCRYPTION_KEY=replace_with_32_random_bytes_as_base64
