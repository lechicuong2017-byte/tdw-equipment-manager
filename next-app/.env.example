# ===== Cơ sở dữ liệu MariaDB (Hostinger: hPanel > Databases > MySQL) =====
# Dùng DATABASE_URL HOẶC nhóm DB_* bên dưới. Mật khẩu có ký tự đặc biệt thì nên dùng DB_*.
# DATABASE_URL=mysql://u590050594_quanly:MAT_KHAU@localhost:3306/u590050594_quanly
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u590050594_quanly
DB_USER=u590050594_quanly
DB_PASSWORD=replace_me
DB_POOL_SIZE=8

# ===== Ứng dụng =====
NEXT_PUBLIC_APP_URL=https://quanly.tdw.com.vn
NEXT_TELEMETRY_DISABLED=1

# Khoá bí mật (mỗi giá trị >= 32 ký tự ngẫu nhiên, KHÁC nhau). Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_ENCRYPTION_KEY=replace_with_random_32_plus_chars
STORAGE_SIGNING_KEY=replace_with_random_32_plus_chars
# Giữ nguyên giá trị đang dùng trên Vercel để giải mã được license phần mềm đã lưu.
SOFTWARE_LICENSE_ENCRYPTION_KEY=replace_with_32_random_bytes_as_base64

# Mã dùng MỘT LẦN cho trang /setup (khởi tạo bảng + tài khoản quản trị đầu tiên). Xoá sau khi xong.
SETUP_TOKEN=replace_with_random_value

# Thư mục lưu hóa đơn/ảnh/tài liệu — đặt NGOÀI public_html, ví dụ:
STORAGE_DIR=/home/u590050594/tdw-storage

# Bảo vệ endpoint cron nhắc hạn (/api/jobs/*)
CRON_SECRET=replace_with_random_value

# ===== Email (mời người dùng, đặt lại mật khẩu) — email tên miền trên Hostinger =====
# Bỏ trống thì liên kết mời sẽ hiện cho quản trị viên tự gửi.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@tdw.com.vn
SMTP_PASSWORD=replace_me
SMTP_FROM="TDW Quản lý <noreply@tdw.com.vn>"

# ===== Tuỳ chọn =====
# CAPACITY_PLAN_LABEL=Hostinger Business
# CAPACITY_DATABASE_LIMIT_BYTES=3000000000
# CAPACITY_STORAGE_LIMIT_BYTES=50000000000
APPS_SCRIPT_EXPORT_URL=https://script.google.com/macros/s/replace_me/exec
APPS_SCRIPT_INTEGRATION_SECRET=replace_with_a_secret_manager_value
